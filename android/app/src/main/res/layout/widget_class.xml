<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="0dp">

    <!-- Accent strip -->
    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/widget_accent_strip" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Header row: "📚 Lexivo" label -->
        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📚 Lexivo"
            android:textSize="10sp"
            android:textColor="#6C63FF"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:includeFontPadding="false" />

        <!-- Class name -->
        <TextView
            android:id="@+id/widget_class_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Class"
            android:textSize="20sp"
            android:textColor="#1A1A2E"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Bottom row: pending HW + due date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Pending badge -->
            <TextView
                android:id="@+id/widget_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 0 done"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:maxLines="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Due date -->
            <TextView
                android:id="@+id/widget_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:maxLines="1" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
