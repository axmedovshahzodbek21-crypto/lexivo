<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_class_bg">

    <!-- Left accent bar (TextView is reliably supported in RemoteViews) -->
    <TextView
        android:id="@+id/widget_left_bar_view"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:background="@drawable/widget_left_bar"
        android:text="" />

    <!-- Top: brand label -->
    <TextView
        android:id="@+id/widget_app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@id/widget_left_bar_view"
        android:layout_marginStart="14dp"
        android:layout_marginTop="11dp"
        android:text="LEXIVO · CLASS"
        android:textSize="8sp"
        android:textColor="#6B63CC"
        android:textAllCaps="true" />

    <!-- Top: role pill -->
    <TextView
        android:id="@+id/widget_role_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="9dp"
        android:background="@drawable/widget_role_pill"
        android:text="Student"
        android:textSize="9sp"
        android:textColor="#9B8BFF"
        android:textStyle="bold"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp" />

    <!-- Class name: centered vertically -->
    <TextView
        android:id="@+id/widget_class_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/widget_left_bar_view"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:text="—"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Bottom row: homework badge + status text -->
    <LinearLayout
        android:id="@+id/widget_bottom_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/widget_left_bar_view"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="11dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_hw_pill_pending"
            android:text="0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text=""
            android:textSize="11sp"
            android:textColor="#7A74BB" />

    </LinearLayout>

    <!-- Hidden compatibility field -->
    <TextView
        android:id="@+id/widget_due"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</RelativeLayout>
